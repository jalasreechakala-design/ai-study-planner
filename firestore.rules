rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token != null && request.auth.token.role == 'admin') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // -------------------------------------------------------------
    // Public Catalog & Roadmaps (Authentic Students Read, Admin Write)
    // -------------------------------------------------------------

    // Exams hierarchy
    match /exams/{examId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();

      match /subjects/{subjectId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();

        match /topics/{topicId} {
          allow read: if isAuthenticated();
          allow write: if isAdmin();

          match /subtopics/{subtopicId} {
            allow read: if isAuthenticated();
            allow write: if isAdmin();
          }
        }
      }
    }

    // Global Subjects Catalog
    match /subjects/{subjectId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Learning Resources
    match /learning_resources/{resourceId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Questions Catalog
    match /questions/{questionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Quizzes Catalog
    match /quizzes/{quizId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Mock Tests Catalog
    match /mock_tests/{testId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------
    // Isolated User Data Subcollections (Strict Student Isolation)
    // -------------------------------------------------------------

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if (isAuthenticated() && request.auth.uid == userId && request.resource.data.role == 'student') || isAdmin();
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin();
      allow delete: if isAdmin();

      match /tasks/{taskId} {
        allow read, write: if isOwner(userId);
      }

      match /notes/{noteId} {
        allow read, write: if isOwner(userId);
      }

      match /attendance/{attendanceId} {
        allow read, write: if isOwner(userId);
      }

      match /cgpa_records/{recordId} {
        allow read, write: if isOwner(userId);
      }

      match /goals/{goalId} {
        allow read, write: if isOwner(userId);
      }

      match /study_sessions/{sessionId} {
        allow read, write: if isOwner(userId);
      }

      match /study_streaks/{streakId} {
        allow read, write: if isOwner(userId);
      }

      match /topic_progress/{progressId} {
        allow read, write: if isOwner(userId);
      }

      match /bookmarks/{bookmarkId} {
        allow read, write: if isOwner(userId);
      }

      match /notifications/{notificationId} {
        allow read, write: if isOwner(userId);
      }

      match /quiz_results/{resultId} {
        allow read, write: if isOwner(userId);
      }

      match /mock_test_results/{resultId} {
        allow read, write: if isOwner(userId);
      }

      match /email_reminders/{reminderId} {
        allow read, write: if isOwner(userId);
      }

      match /target_exam/{targetId} {
        allow read, write: if isOwner(userId);
      }

      match /exam_targets/{targetId} {
        allow read, write: if isOwner(userId);
      }

      match /subjects/{subjectId} {
        allow read, write: if isOwner(userId);
      }

      match /assignments/{assignmentId} {
        allow read, write: if isOwner(userId);
      }

      match /reminders/{reminderId} {
        allow read, write: if isOwner(userId);
      }

      match /analytics/{analyticsId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
