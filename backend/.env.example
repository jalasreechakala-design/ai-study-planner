# Server Port Configuration
PORT=5000

# JSON Web Token Secret
JWT_SECRET=your_jwt_secret_key_here

# Production Allowed Frontend Domain for CORS (e.g. Vercel, Netlify, Render)
FRONTEND_URL=https://your-frontend.onrender.com

# Firebase Admin SDK Server-Side Credentials (DO NOT share or expose in client code)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
# Optional: Alternative path to downloaded service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=

# Database / Fallback Connection Credentials (Optional if using MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=study_planner
DB_SSL=false
